    "NotifyOnThreshold": false,
    "UiScale": 1.25,
    "Glassmorphism": true,
    "GlassStrength": "Strong",
    "PopupGraph": "half-circle",
    "PopupPosition": "LastPosition",
    "LastPopupX": 1200,
    "LastPopupY": 640,
    "ShapeTheme": "MixMatch",
    "ColorTheme": "DarkBluePurple",
    "TimeDisplayMode": "RemainingTime",
    "IsPinned": true,
    "Providers": {
      "codex": { "Enabled": true, "RefreshSeconds": 120, "ShowSecondaryRows": true, "ShowCredits": true, "Command": "codex" },
      "claude": { "Enabled": false, "RefreshSeconds": 300, "ShowSecondaryRows": false, "ShowCredits": false, "Command": "claude" }
    }
  }
}
